# Copy to .env and fill in real values. .env is git-ignored — never commit it.

# --- SecureAI Guard API (from the organizers) ---
GUARD_URL=https://your-guard-url-from-organizers
GUARD_TOKEN=sai_your_team_token

# --- LLM API (OpenAI-compatible) ---
# Use your OWN key for safety. The hackathon key was shared in plaintext and
# should be rotated. Load from here, never hard-code it.
LLM_API_KEY=sk-proj-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Armor policy ---
# false = fail CLOSED (secure default). Set true only to DEMO the insecure case.
FAIL_OPEN=false
CONVO_WINDOW=6

# --- Alerts / email (optional) ---
# Who gets alerted on a blocked attempt (can also be set live in the UI).
OWNER_EMAIL=
# To actually SEND email, fill these. For Gmail, SMTP_PASS must be an App Password
# (Google account → Security → App passwords), NOT your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Server ---
HOST=127.0.0.1
PORT=8000
